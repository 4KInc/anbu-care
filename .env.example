# ---- Google Cloud / Vertex AI (mandatory stack) ----
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=anbu-care-hack
GOOGLE_CLOUD_LOCATION=global
# `gcloud auth application-default login` resets ADC's quota project to your
# gcloud default, which silently sends billing and quota for every Vertex and
# Firestore call to the wrong project. Setting it here pins it regardless.
GOOGLE_CLOUD_QUOTA_PROJECT=anbu-care-hack

# Any Gemini 3.5+ model satisfies the hackathon mandate.
ANBU_MODEL=gemini-3.5-flash

# ---- Firestore ----
# Leave FIRESTORE_EMULATOR_HOST unset to hit the real database.
# FIRESTORE_EMULATOR_HOST=localhost:8080
ANBU_FIRESTORE_DATABASE=(default)

# Set to "memory" to run the whole system with no Firestore at all (tests/CI).
ANBU_STORE_BACKEND=firestore

# ---- Pub/Sub ----
ANBU_TOPIC_INTAKE=anbu-intake-events
ANBU_TOPIC_CASE_UPDATES=anbu-case-updates
ANBU_TOPIC_CLAIM_STATUS=anbu-claim-status
ANBU_PUBSUB_ENABLED=false

# ---- Provenance signing ----
# Ed25519 private key, PKCS#8 PEM, base64-encoded. Generate with:
#   uv run python -m anbu_care.provenance.keygen
# If unset, an ephemeral dev key is generated at import time (NOT for production).
ANBU_SIGNING_KEY_B64=

# ---- WhatsApp (sandbox only for the hackathon) ----
# off | twilio | meta. "off" records the gate decision and sends nothing.
ANBU_WHATSAPP_MODE=off

# Twilio WhatsApp sandbox — real delivery to numbers that have sent
# "join <code>" to the sandbox number. No Meta business verification and no
# template approval. Never commit these; export them or use Secret Manager.
TWILIO_ACCOUNT_SID=
# Prefer an API key over the account auth token: it is revocable on its own,
# without rotating the token every other integration depends on. If both are
# set the API key wins. Either satisfies the transport.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
# Your account's own sandbox sender — NOT the number in the docs.
TWILIO_WHATSAPP_FROM=

# ---- Insurer / TPA ----
# No production TPA API exists to integrate against in this window.
# The liaison agent submits to a simulated endpoint, labeled as such everywhere.
ANBU_TPA_MODE=simulated
ANBU_TPA_ENDPOINT=

# Family-session credential for the dashboard. Not a secret — published in the
# README. The guarantee being demonstrated is server-side enforcement.
ANBU_DEMO_TOKEN=anbu-demo-family-token

# Meta WhatsApp Cloud API (free test sender; no payment method required).
# Set ANBU_WHATSAPP_MODE=meta to use these instead of Twilio.
# From the app dashboard: WhatsApp -> Step 1. Try it out.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v25.0

# Attachable documents. The bucket stays private: objects are served through
# short-lived V4 signed URLs, never made public. Leave unset to send messages
# without attachments (the send still works, it just says nothing was attached).
ANBU_ARTIFACT_BUCKET=
# Only needed where the credentials have no private key of their own, e.g. a
# developer laptop using `gcloud auth application-default login`. Cloud Run
# signs with its own service account and does not need this.
ANBU_SIGNER_SERVICE_ACCOUNT=

# Voice escalation. A message at 2am may go unread until morning; a ringing
# phone does not. Off by default: a call costs money and reaches a real person
# at an hour they did not choose.
#
# Voice needs a PURCHASED Twilio number. The WhatsApp sandbox cannot place
# calls. Anbu Care never dials 108: Twilio's emergency calling does not cover
# India, and a recording cannot answer a dispatcher's questions anyway.
ANBU_VOICE_MODE=off
TWILIO_VOICE_FROM=

# Google Maps browser key, served to the dashboard by /api/map-config so the
# Routing tab can draw the hospitals it scored. This one is NOT a secret in the
# usual sense — Maps JS requires the browser to hold it — so the control that
# matters is restriction, not concealment. Restrict it by HTTP referrer to the
# deployed host and to the Maps JavaScript and Places APIs only. Unset, the map
# degrades to a plain "no maps key is configured" note rather than breaking.
ANBU_MAPS_API_KEY=

# Signs the expiring links in urgent alerts, so a family member woken at 2am can
# tap through instead of hunting for a token. Leave unset and links still work,
# they just ask for a sign-in. There is deliberately NO default: a hardcoded
# fallback would mean every deployment shared a signing key.
ANBU_LINK_SECRET=

# The service's own public URL. Only used to build an ABSOLUTE link inside the
# emergency-handoff QR code — a QR carrying a relative path scans to nothing,
# and the person scanning it is a nurse in a corridor who will not debug it.
# Unset, the link still works when clicked; only the QR degrades.
ANBU_PUBLIC_BASE_URL=

# ---- Outbound Tamil ------------------------------------------------------
# Messages TO a recipient whose language preference is "ta" are rendered into
# Tamil from the recorded English, which stays the source of truth. Per-person:
# the mother's profile and each family contact carry their own `language`.
# "off" falls back to the recorded English with a note saying so, which is also
# what a timeout does. There is no mode that guesses.
ANBU_TRANSLATE_MODE=gemini

# ---- Recovery check-ins --------------------------------------------------
# The fortnight after a discharge summary is recorded. One message a day, at
# this hour in HER timezone. Both are deployment policy, not clinical
# constants, which is why they are here rather than in the code.
ANBU_RECOVERY_WINDOW_DAYS=14
ANBU_RECOVERY_HOUR=9

# The parent's own handset and the language she reads, for the seeded demo.
# Defaults to a Twilio test number that accepts sends and delivers nothing, so
# an unconfigured deploy cannot message a real person.
ANBU_DEMO_PARENT_E164=
ANBU_DEMO_PARENT_LANGUAGE=ta
